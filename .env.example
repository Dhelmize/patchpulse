# Server Configuration
PORT=3000
HOST=0.0.0.0
DB_DIR=./data

# LLM Configuration
# Choose provider: gemini, openai, or openai-compatible
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
# For OpenAI-compatible endpoints (optional)
LLM_BASE_URL=

# GitHub Configuration (for GitHubPRAdapter)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_DEFAULT_BRANCH=main

# MediaWiki Configuration (for MediaWikiAdapter)
MEDIAWIKI_API_URL=https://wiki.example.com/api.php
MEDIAWIKI_USERNAME=your_wiki_username
MEDIAWIKI_PASSWORD=your_wiki_password
# Alternative: Use API token instead of username/password
MEDIAWIKI_API_TOKEN=your_wiki_api_token

# Discord Configuration (for DiscordWebhookAdapter)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Scraping Configuration
USER_AGENT=PatchPulse/1.0
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
